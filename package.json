{
  "name": "electrician-skilllab",
  "version": "1.0.0",
  "description": "Bilingual digital learning platform for ITI Electrician trade — virtual labs, circuit simulators, and gamified challenges",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --workspace=client run dev",
    "dev:server": "npm --workspace=server run dev",
    "build": "npm --workspace=client run build",
    "start": "npm --workspace=server run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
